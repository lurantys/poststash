{
  "manifest_version": 3,
  "name": "Poststash",
  "version": "1.5.1",
  "minimum_chrome_version": "116",
  "description": "Save media from social profiles.",
  "permissions": ["activeTab", "downloads", "scripting", "offscreen"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.cdninstagram.net/*",
    "https://*.fbcdn.net/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https://*.cdninstagram.com https://*.fbcdn.net;"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["session-media.js", "capture.js", "viewer.js", "story-frame.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["page-button.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Poststash",
    "default_popup": "popup.html"
  }
}
