{
  "manifest_version": 3,
  "name": "Poststash",
  "version": "1.5.1",
  "minimum_chrome_version": "116",
  "description": "Download photos and videos from Instagram, TikTok, and X.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.cdninstagram.net/*",
    "https://*.fbcdn.net/*",
    "https://*.tiktok.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://x.com/*",
    "https://www.x.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https://*.cdninstagram.com https://*.fbcdn.net;"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "session-media.js",
        "capture.js",
        "viewer.js",
        "story-frame.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "page-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://tiktok.com/*"
      ],
      "js": [
        "tiktok-session.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://tiktok.com/*"
      ],
      "js": [
        "tiktok-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "x-session.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "x-button.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Poststash",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/poststash-16.png",
      "32": "assets/icons/poststash-32.png",
      "48": "assets/icons/poststash-48.png",
      "128": "assets/icons/poststash-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/poststash-16.png",
    "32": "assets/icons/poststash-32.png",
    "48": "assets/icons/poststash-48.png",
    "128": "assets/icons/poststash-128.png"
  }
}
